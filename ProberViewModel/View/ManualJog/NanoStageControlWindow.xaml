                                        <Button Content="Home(0.0)" Command="{Binding HomeCommand}" CommandParameter="2" Margin="1,0"/>
                                        <Button Content="Jog + ▶" Command="{Binding JogCommand}" CommandParameter="2+" Background="#1B2A2C" BorderBrush="#00838F" Margin="1,0"/>
                                    </UniformGrid>
                                </Grid>
                            </Grid>
