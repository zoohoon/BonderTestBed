                                    <TextBlock Text="│ CURRENT POSITION (실시간 현재 피드백 위치)" FontSize="12" Foreground="#A0FFFFFF" Margin="0,0,0,2"/>
                                    <Border Background="#0A0A0B" BorderBrush="#004D40" BorderThickness="1" Padding="6,4">
                                        <TextBlock Text="{Binding CurrentPosZ, StringFormat=[    \{0:F3\} μm    ]}" FontSize="28" FontWeight="Bold" Foreground="#00E5FF" HorizontalAlignment="Center" FontFamily="Consolas"/>
                                    </Border>
                                </StackPanel>
                                <Grid Grid.Row="2" Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="│ ABS MOVE Target :" FontSize="13" Foreground="#A0FFFFFF" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding TargetPosZ, StringFormat={}{0:F3}, UpdateSourceTrigger=LostFocus, Delay=500}"/>
                                    <Button Grid.Column="2" Content="Abs Move" Command="{Binding MoveCommand}" CommandParameter="1" MinWidth="80" Margin="5,0,0,0"/>
                                </Grid>
                                <Grid Grid.Row="3" Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="│ JOG Step :" FontSize="13" Foreground="#A0FFFFFF" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding JogStepZ, StringFormat={}{0:F3}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=500}" HorizontalContentAlignment="Center"/>
                                    <UniformGrid Grid.Column="2" Columns="3" Margin="5,0,0,0">
                                        <Button Content="◀ Jog -" Command="{Binding JogCommand}" CommandParameter="1-" Background="#1B2A2C" BorderBrush="#00838F" Margin="1,0"/>
                                        <Button Content="Home(0.0)" Command="{Binding HomeCommand}" CommandParameter="1" Margin="1,0"/>
                                        <Button Content="Jog + ▶" Command="{Binding JogCommand}" CommandParameter="1+" Background="#1B2A2C" BorderBrush="#00838F" Margin="1,0"/>
                                    </UniformGrid>
                                </Grid>
                            </Grid>
