                                        <Button Content="◀ Jog -" Command="{Binding JogCommand}" CommandParameter="6-" Background="#3E2723" BorderBrush="#DBA506" Margin="1,0"/>
                                        <Button Content="Home(0.0)" Command="{Binding HomeCommand}" CommandParameter="6" Margin="1,0"/>
                                        <Button Content="Jog + ▶" Command="{Binding JogCommand}" CommandParameter="6+" Background="#3E2723" BorderBrush="#DBA506" Margin="1,0"/>
                                    </UniformGrid>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource AxisCardBorderStyle}" BorderBrush="#DBA506" Background="#212015">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="■ θZ AXIS (-0.0257 ~ 0.0257 deg)" FontSize="15" FontWeight="Bold" Foreground="#FFD600"/>
                                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,2">
                                    <TextBlock Text="│ CURRENT POSITION (실시간 현재 피드백 위치)" FontSize="12" Foreground="#A0FFFFFF" Margin="0,0,0,2"/>
                                    <Border Background="#0A0A0B" BorderBrush="#5D4037" BorderThickness="1" Padding="6,4">
                                        <TextBlock Text="{Binding CurrentPosRotZDeg, StringFormat=[    \{0:F5\} deg    ]}" FontSize="24" FontWeight="Bold" Foreground="#FFD600" HorizontalAlignment="Center" FontFamily="Consolas"/>
                                    </Border>
                                </StackPanel>
                                <Grid Grid.Row="2" Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="│ ABS MOVE Target :" FontSize="13" Foreground="#A0FFFFFF" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding TargetPosRotZDeg, UpdateSourceTrigger=LostFocus}"/>
                                    <Button Grid.Column="2" Content="Abs Move" Command="{Binding MoveCommand}" CommandParameter="3" MinWidth="80" Margin="5,0,0,0" Background="#3E2723" BorderBrush="#DBA506"/>
                                </Grid>
                                <Grid Grid.Row="3" Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="│ JOG Step :" FontSize="13" Foreground="#A0FFFFFF" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding JogStepRotZ, StringFormat={}{0:F5}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=500}" HorizontalContentAlignment="Center"/>
                                    <UniformGrid Grid.Column="2" Columns="3" Margin="5,0,0,0">
                                        <Button Content="◀ Jog -" Command="{Binding JogCommand}" CommandParameter="3-" Background="#3E2723" BorderBrush="#DBA506" Margin="1,0"/>
                                        <Button Content="Home(0.0)" Command="{Binding HomeCommand}" CommandParameter="3" Margin="1,0"/>
                                        <Button Content="Jog + ▶" Command="{Binding JogCommand}" CommandParameter="3+" Background="#3E2723" BorderBrush="#DBA506" Margin="1,0"/>
                                    </UniformGrid>
                                </Grid>
                            </Grid>
                        </Border>

                    </UniformGrid>
                </Grid>
            </GroupBox>
        </Grid>

        <Border Grid.Row="1" Background="#1E1E1F" BorderBrush="#2D2D30" BorderThickness="1" CornerRadius="3" Margin="4,6" Padding="12,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Status │ " FontSize="14" Foreground="#88FFFFFF" VerticalAlignment="Center"/>
                    <TextBlock Text="3-Axis: " FontSize="14" Foreground="#A0FFFFFF" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Axis3VM.ConnectionStatus}" FontSize="15" FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center"/>
                    <TextBlock Text="   " VerticalAlignment="Center"/>
                    <TextBlock Text="6-Axis: " FontSize="14" Foreground="#A0FFFFFF" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Axis6VM.ConnectionStatus}" FontSize="15" FontWeight="Bold" Foreground="#00FF66" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Connect to 3Axis controller" Command="{Binding Axis3VM.ConnectCommand}" Width="200" Height="32" Margin="3,0" Background="#1B2A2C" BorderBrush="#00838F" FontWeight="Bold"/>
                    <Button Content="Connect to 6Axis controller" Command="{Binding Axis6VM.ConnectCommand}" Width="200" Height="32" Margin="3,0" Background="#3E2723" BorderBrush="#DBA506" FontWeight="Bold"/>
                    <Button Content="▶ Request Vision Data (TCP)" Command="{Binding Axis6VM.RequestVisionCommand}" Width="200" Height="32" Margin="3,0" Background="#3E2723" BorderBrush="#DBA506" FontWeight="Bold"/>
                    <Button Content="WAFER" Command="{Binding Axis6VM.WaferCommand}" Width="100" Height="32" Margin="3,0" Background="#3E2723" BorderBrush="#DBA506" FontWeight="Bold" CommandParameter="WAFER"/>
                    <Button Content="DIE" Command="{Binding Axis6VM.DieCommand}" Width="100" Height="32" Margin="3,0" Background="#3E2723" BorderBrush="#DBA506" FontWeight="Bold" CommandParameter="DIE"/>
                    <Button Content="Manual" Command="{Binding Axis6VM.ManualCommand}" Width="50" Height="32" Margin="3,0" Background="#424242"/>
                    <Button Content="jog" Command="{Binding Axis6VM.JogButtonCommand}" Width="50" Height="32" Margin="3,0" Background="#424242"/>
                    <Border BorderBrush="#3F3F46" BorderThickness="1,0,0,0" Margin="6,2" Padding="3,0,0,0"/>
                    <Button Content="Disconnect All" Command="{Binding MainDisconnectCommand}" Width="110" Height="32" Margin="3,0" Background="#424242"/>
                    <Button Content="Total Move All" Command="{Binding MainTotalMoveCommand}" Width="120" Height="32" Margin="3,0" Background="#2E7D32" BorderBrush="#4CAF50" FontWeight="Bold"/>
                    <Button Content="All Log Clear" Command="{Binding MainClearLogCommand}" Width="120" Height="32" Margin="3,0" Background="#6A1B9A" BorderBrush="#9C27B0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="4,0,4,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="115"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="■ SYSTEM TERMINAL LOG &amp; TCP COMMUNICATION HISTORY" Foreground="#555555" FontSize="11" FontWeight="Bold" Margin="0,0,0,3"/>

            <UniformGrid Grid.Row="1" Columns="3" Rows="1">
                <Grid Margin="0,0,4,0" DataContext="{Binding Axis3VM}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="[ 3-Axis Terminal Log ]" Foreground="#00E5FF" FontSize="13" Margin="2,0,0,2"/>
                    <ListBox Grid.Row="1" ItemsSource="{Binding LogMessages}" Background="#09090A" Foreground="#00FF66" BorderBrush="#2D2D30" ScrollViewer.VerticalScrollBarVisibility="Auto" Padding="3">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="11" FontFamily="Consolas" Margin="1"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <Grid Margin="4,0,4,0" DataContext="{Binding Axis6VM}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="[ 6-Axis Terminal Log ]" Foreground="#FFD600" FontSize="13" Margin="2,0,0,2"/>
                    <ListBox Grid.Row="1" ItemsSource="{Binding LogMessages6Axis}" Background="#09090A" Foreground="#FFB300" BorderBrush="#2D2D30" ScrollViewer.VerticalScrollBarVisibility="Auto" Padding="3">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="11" FontFamily="Consolas" Margin="1"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <Grid Margin="4,0,0,0" DataContext="{Binding Axis6VM}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="[ TCP Communication Log ]" Foreground="#FF9800" FontSize="13" Margin="2,0,0,2"/>
                    <ListBox Grid.Row="1" ItemsSource="{Binding CommLogMessages}" Background="#09090A" Foreground="#FF9800" BorderBrush="#2D2D30" ScrollViewer.VerticalScrollBarVisibility="Auto" Padding="3">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="11" FontFamily="Consolas" Margin="1"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </UniformGrid>
        </Grid>
    </Grid>
</Window>