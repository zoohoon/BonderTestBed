                                    <TextBox Grid.Column="1" Text="{Binding JogStepRotX, StringFormat={}{0:F5}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=500}" HorizontalContentAlignment="Center"/>
