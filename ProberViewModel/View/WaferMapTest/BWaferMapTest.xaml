<UserControl x:Class="BWaferMapTestView.BWaferMapTest"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:ValueConverters;assembly=ValueConverters"
             xmlns:local="clr-namespace:BWaferMapTestView"
             mc:Ignorable="d" 
             d:DesignHeight="630" d:DesignWidth="950">
    <UserControl.Resources>
        <ResourceDictionary>
            <!--Converter-->
            <conv:ViewTargetConverter x:Key="ViewTargetConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="630"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="630"/>
        </Grid.RowDefinitions>

        <!-- Wafer Map Display Area -->
        <Grid Grid.Row="0" Grid.Column="0">

            <Border Margin="5"
            BorderBrush="WhiteSmoke"
            BorderThickness="1">

                <Grid>

                    <ContentControl Width="600"
                            Height="600"
                            Content="{Binding ViewTarget,
                                              Converter={StaticResource ViewTargetConverter},
                                              ConverterParameter=Left}" />
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="0" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                       Text="조건 선택" FontSize="20" Margin="20"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Button Grid.Row="1" Grid.Column="0" Margin="10" 
                    Content="X 홀수" Command="{Binding XOddNumberCommand}"/>
            <Button Grid.Row="1" Grid.Column="1" Margin="10" 
                    Content="X 짝수" Command="{Binding XEvenNumberCommand}" />
            <Button Grid.Row="2" Grid.Column="0" Margin="10" 
                    Content="Y 홀수" Command="{Binding YOddNumberCommand}"/>
            <Button Grid.Row="2" Grid.Column="1" Margin="10" 
                    Content="Y 짝수" Command="{Binding YEvenNumberCommand}" />

            <TextBox Grid.Row="3" Grid.Column="0" Margin="5" HorizontalAlignment="Stretch" TextAlignment="Right" Foreground="White"
                     Text="{Binding JumpNumber}"/>
            <Button Grid.Row="3" Grid.Column="1" Margin="10" 
                    Content="번 간격마다" Command="{Binding JumpNumberCommand}" />

            <ComboBox Grid.Row="4" Grid.Column="0" Margin="10" Width="120" Height="30" Foreground="White"
                      SelectedIndex="{Binding ScanModeIndex}">
                <ComboBoxItem Content="1 - →↓←↓" />
                <ComboBoxItem Content="2 - →↑←↑" />
                <ComboBoxItem Content="3 - ↓→↑→" />
                <ComboBoxItem Content="4 - ↓←↑←" />
            </ComboBox>
            <Button Grid.Row="4" Grid.Column="1" Margin="10"
                    Content="Moving" Command="{Binding ChuckMoveCommand}"/>


            <TextBox Grid.Row="5" Grid.Column="0" Margin="5" HorizontalAlignment="Stretch" TextAlignment="Right" Foreground="White"
                     Text="{Binding RandomCount}"/>
            <Button Grid.Row="5" Grid.Column="1" Margin="10"
                    Content="Random Map" Command="{Binding RandomMapCommand}"/>

        </Grid>
    </Grid>
</UserControl>
