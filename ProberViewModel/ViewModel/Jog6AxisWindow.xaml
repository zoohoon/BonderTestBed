<Window x:Class="ManualJogView.Jog6AxisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="6-Axis Precision Jog" 
        Width="2050" Height="220" 
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent" 
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"> 

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style TargetType="Border">
            <Setter Property="Background" Value="#1E1E1F"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#09090A"/>
            <Setter Property="Foreground" Value="#00E5FF"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,0,5,0"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#4A4A4F"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="5,2"/>
        </Style>
        <Style x:Key="StepLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CurrentPosStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A0FFFFFF"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <UniformGrid Columns="6" Rows="1">
            <Border>
                <StackPanel>
                    <TextBlock Text="Nano Stage X Axis" Foreground="#FFD600" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
                    <TextBlock Text="CURRENT POSITION" Style="{StaticResource CurrentPosStyle}"/>
                    <TextBlock Text="{Binding CurrentPosX, StringFormat=\{0:F3\} μm}" Foreground="#00E5FF" FontSize="20" FontWeight="Bold" Margin="0,0,0,5"/>
                    <Grid Margin="0,5" Visibility="{Binding IsSimpleMode, Converter={StaticResource BoolToVis}, ConverterParameter=Inverted}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Step:" Style="{StaticResource StepLabelStyle}"/>
                        <TextBox Grid.Column="1" Text="{Binding JogStepX, StringFormat={}{0:F3}, UpdateSourceTrigger=LostFocus}"/>
                    </Grid>
                    <UniformGrid Columns="2" Visibility="{Binding IsSimpleMode, Converter={StaticResource BoolToVis}, ConverterParameter=Inverted}">
                        <Button Content="-" Command="{Binding JogCommand}" CommandParameter="1-" Margin="2"/>
                        <Button Content="+" Command="{Binding JogCommand}" CommandParameter="1+" Margin="2"/>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border>
                <StackPanel>
                    <TextBlock Text="Nano Stage Y Axis" Foreground="#FFD600" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
                    <TextBlock Text="CURRENT POSITION" Style="{StaticResource CurrentPosStyle}"/>
                    <TextBlock Text="{Binding CurrentPosY, StringFormat=\{0:F3\} μm}" Foreground="#00E5FF" FontSize="20" FontWeight="Bold" Margin="0,0,0,5"/>
                    <Grid Margin="0,5" Visibility="{Binding IsSimpleMode, Converter={StaticResource BoolToVis}, ConverterParameter=Inverted}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Step:" Style="{StaticResource StepLabelStyle}"/>
                        <TextBox Grid.Column="1" Text="{Binding JogStepY, StringFormat={}{0:F3}, UpdateSourceTrigger=LostFocus}"/>
                    </Grid>
                    <UniformGrid Columns="2" Visibility="{Binding IsSimpleMode, Converter={StaticResource BoolToVis}, ConverterParameter=Inverted}">
                        <Button Content="-" Command="{Binding JogCommand}" CommandParameter="2-" Margin="2"/>
                        <Button Content="+" Command="{Binding JogCommand}" CommandParameter="2+" Margin="2"/>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border>
                <StackPanel>
                    <TextBlock Text="Nano Stage Z Axis" Foreground="#FFD600" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
                    <TextBlock Text="CURRENT POSITION" Style="{StaticResource CurrentPosStyle}"/>
                    <TextBlock Text="{Binding CurrentPosZ, StringFormat=\{0:F3\} μm}" Foreground="#00E5FF" FontSize="20" FontWeight="Bold" Margin="0,0,0,5"/>
                    <Grid Margin="0,5" Visibility="{Binding IsSimpleMode, Converter={StaticResource BoolToVis}, ConverterParameter=Inverted}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Step:" Style="{StaticResource StepLabelStyle}"/>
                        <TextBox Grid.Column="1" Text="{Binding JogStepZ, StringFormat={}{0:F3}, UpdateSourceTrigger=LostFocus}"/>
                    </Grid>
                    <UniformGrid Columns="2" Visibility="{Binding IsSimpleMode, Converter={StaticResource BoolToVis}, ConverterParameter=Inverted}">
                        <Button Content="-" Command="{Binding JogCommand}" CommandParameter="4-" Margin="2"/>
                        <Button Content="+" Command="{Binding JogCommand}" CommandParameter="4+" Margin="2"/>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border>
                <StackPanel>
                    <TextBlock Text="Nano Stage θX Axis" Foreground="#FFD600" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
                    <TextBlock Text="CURRENT POSITION" Style="{StaticResource CurrentPosStyle}"/>
                    <TextBlock Text="{Binding CurrentPosRotXDeg, StringFormat=\{0:F5\} deg}" Foreground="#00E5FF" FontSize="20" FontWeight="Bold" Margin="0,0,0,5"/>
                    <Grid Margin="0,5" Visibility="{Binding IsSimpleMode, Converter={StaticResource BoolToVis}, ConverterParameter=Inverted}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Step:" Style="{StaticResource StepLabelStyle}"/>
                        <TextBox Grid.Column="1" Text="{Binding JogStepRotX, StringFormat={}{0:F5}, UpdateSourceTrigger=LostFocus}"/>
                    </Grid>
                    <UniformGrid Columns="2" Visibility="{Binding IsSimpleMode, Converter={StaticResource BoolToVis}, ConverterParameter=Inverted}">
                        <Button Content="-" Command="{Binding JogCommand}" CommandParameter="5-" Margin="2"/>
                        <Button Content="+" Command="{Binding JogCommand}" CommandParameter="5+" Margin="2"/>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border>
                <StackPanel>
                    <TextBlock Text="Nano Stage θY Axis" Foreground="#FFD600" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
                    <TextBlock Text="CURRENT POSITION" Style="{StaticResource CurrentPosStyle}"/>
                    <TextBlock Text="{Binding CurrentPosRotYDeg, StringFormat=\{0:F5\} deg}" Foreground="#00E5FF" FontSize="20" FontWeight="Bold" Margin="0,0,0,5"/>
                    <Grid Margin="0,5" Visibility="{Binding IsSimpleMode, Converter={StaticResource BoolToVis}, ConverterParameter=Inverted}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Step:" Style="{StaticResource StepLabelStyle}"/>
                        <TextBox Grid.Column="1" Text="{Binding JogStepRotY, StringFormat={}{0:F5}, UpdateSourceTrigger=LostFocus}"/>
                    </Grid>
                    <UniformGrid Columns="2" Visibility="{Binding IsSimpleMode, Converter={StaticResource BoolToVis}, ConverterParameter=Inverted}">
                        <Button Content="-" Command="{Binding JogCommand}" CommandParameter="6-" Margin="2"/>
                        <Button Content="+" Command="{Binding JogCommand}" CommandParameter="6+" Margin="2"/>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border>
                <StackPanel>
                    <TextBlock Text="Nano Stage θZ (Rz) Axis" Foreground="#FFD600" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
                    <TextBlock Text="CURRENT POSITION" Style="{StaticResource CurrentPosStyle}"/>
                    <TextBlock Text="{Binding CurrentPosRotZDeg, StringFormat=\{0:F5\} deg}" Foreground="#00E5FF" FontSize="20" FontWeight="Bold" Margin="0,0,0,5"/>
                    <Grid Margin="0,5" Visibility="{Binding IsSimpleMode, Converter={StaticResource BoolToVis}, ConverterParameter=Inverted}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Step:" Style="{StaticResource StepLabelStyle}"/>
                        <TextBox Grid.Column="1" Text="{Binding JogStepRotZ, StringFormat={}{0:F5}, UpdateSourceTrigger=LostFocus}"/>
                    </Grid>
                    <UniformGrid Columns="2" Visibility="{Binding IsSimpleMode, Converter={StaticResource BoolToVis}, ConverterParameter=Inverted}">
                        <Button Content="-" Command="{Binding JogCommand}" CommandParameter="3-" Margin="2"/>
                        <Button Content="+" Command="{Binding JogCommand}" CommandParameter="3+" Margin="2"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </UniformGrid>
    </Grid>
</Window>